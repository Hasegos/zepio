---
import BaseLayout from "../layouts/BaseLayout.astro";
import Mascot from "../components/Mascot.astro";
import { liveGames } from "../games/registry.js";

const CATEGORY_LABELS = { puzzle: "퍼즐", arcade: "아케이드", casual: "캐주얼" };
const dailyGame = liveGames.find((game) => game.hasDaily);
---

<BaseLayout
  title="Zepio | 무료 웹게임"
  description="회원가입 없이 브라우저에서 바로 즐기는 무료 웹게임 플랫폼 Zepio입니다."
>
  <section class="flex items-center gap-4 rounded-3xl bg-gradient-to-br from-primary to-violet-700 p-5 text-white sm:p-8">
    <div class="flex-1">
      <h1 class="text-3xl font-extrabold sm:text-4xl">Play Something New</h1>
      <p class="mt-2 text-indigo-100">다운로드나 회원가입 없이 브라우저에서 바로 즐기는 무료 웹게임.</p>
      <a href="#games" class="mt-4 inline-block rounded-xl bg-white px-5 py-2.5 font-bold text-primary">
        게임 둘러보기
      </a>
    </div>
    <Mascot size={96} class="size-20 shrink-0 sm:size-28" />
  </section>

  {
    dailyGame && (
      <section
        data-daily
        data-game-id={dailyGame.id}
        class="mt-8 rounded-2xl border border-primary/30 bg-indigo-50 p-4"
      >
        <h2 class="text-lg font-bold">오늘의 도전</h2>
        <p data-daily-text class="mt-1 text-sm text-slate-700">
          매일 새로 열리는 5문제. 모두 같은 문제로 도전해요.
        </p>
        <a
          href={`/games/${dailyGame.slug}`}
          class="mt-3 inline-block rounded-xl bg-primary px-5 py-2.5 font-bold text-white"
        >
          도전하러 가기
        </a>
      </section>
    )
  }

  <section data-recent hidden class="mt-8">
    <h2 class="mb-3 text-xl font-bold">이어서 하기</h2>
    <ul data-recent-list class="flex flex-wrap gap-2"></ul>
  </section>

  <h2 id="games" class="mb-3 mt-8 scroll-mt-4 text-xl font-bold">추천 게임</h2>
  <ul class="grid gap-4 sm:grid-cols-2">
    {
      liveGames.map((game) => (
        <li
          data-game-card={game.id}
          data-slug={game.slug}
          data-name={game.name}
          class="overflow-hidden rounded-2xl bg-white shadow-sm transition hover:-translate-y-0.5 hover:shadow-md motion-reduce:transition-none motion-reduce:hover:translate-y-0"
        >
          <img src={game.thumbnail} alt="" width="320" height="180" class="aspect-video w-full object-cover" />
          <div class="p-4">
            <div class="flex items-center justify-between gap-2">
              <h3 class="text-lg font-bold">{game.name}</h3>
              <span class="shrink-0 rounded-full bg-indigo-50 px-2.5 py-0.5 text-xs font-bold text-primary">
                {CATEGORY_LABELS[game.category] ?? game.category}
              </span>
            </div>
            <p class="mt-1 text-sm text-slate-600">{game.description}</p>
            <p class="mt-1 text-xs text-slate-600">{game.estimatedPlayTime}</p>
            <p data-record hidden class="mt-1 text-sm font-bold text-primary" />
            <a
              href={`/games/${game.slug}`}
              class="mt-3 inline-block rounded-xl bg-primary px-5 py-2.5 font-bold text-white"
            >
              플레이하기
            </a>
          </div>
        </li>
      ))
    }
  </ul>
</BaseLayout>

<script>
  import { summarizers } from "../games/records.js";
  import { currentStreak, kstDate } from "../lib/daily.js";
  import { loadRecords } from "../lib/storage.js";

  const { games, recent, daily } = loadRecords();
  const cards = new Map(
    [...document.querySelectorAll("[data-game-card]")].map((card) => [card.dataset.gameCard, card]),
  );

  for (const [id, card] of cards) {
    const entry = games[id];
    const plays = Number.isInteger(entry?.plays) ? entry.plays : 0;
    const text = entry ? summarizers[id]?.(entry.data, plays) : "";
    const line = card.querySelector("[data-record]");
    if (text && line) {
      line.textContent = text;
      line.hidden = false;
    }
  }

  const banner = document.querySelector("[data-daily]");
  const bannerText = document.querySelector("[data-daily-text]");
  const record = banner ? daily[banner.dataset.gameId] : null;
  if (bannerText && record) {
    const today = kstDate(Date.now());
    const streak = currentStreak(record, today);
    if (record.last === today) {
      bannerText.textContent = `오늘 완료 · 연속 ${streak}일. 내일 새로운 문제가 열려요.`;
    } else if (streak > 0) {
      bannerText.textContent = `오늘의 문제가 기다려요 · 연속 ${streak}일을 이어가는 중`;
    }
  }

  const list = document.querySelector("[data-recent-list]");
  const section = document.querySelector("[data-recent]");
  const ids = recent.filter((id) => cards.has(id));
  if (list && section && ids.length) {
    for (const id of ids) {
      const card = cards.get(id);
      const link = document.createElement("a");
      link.href = `/games/${card.dataset.slug}`;
      link.textContent = card.dataset.name;
      link.className = "rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-bold text-primary";
      const item = document.createElement("li");
      item.append(link);
      list.append(item);
    }
    section.hidden = false;
  }
</script>