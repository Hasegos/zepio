---
import BaseLayout from "../layouts/BaseLayout.astro";
import Mascot from "../components/Mascot.astro";
import { liveGames } from "../games/registry.js";

const CATEGORY_LABELS = { puzzle: "퍼즐", arcade: "아케이드", casual: "캐주얼", simulation: "시뮬레이션" };
const dailyGame = liveGames.find((game) => game.hasDaily);
const SORTS = [
  { id: "recommended", label: "추천순" },
  { id: "newest", label: "신작순" },
  { id: "plays", label: "많이 한 순", needsRecords: true },
  { id: "recent", label: "최근 한 순", needsRecords: true },
  { id: "short", label: "짧은 순" },
];
const GUIDE = [
  { lead: "2~5분 안에 한 판 끝내고 싶다면", ids: ["stack-tower", "light-flip", "pattern-challenge"] },
  { lead: "논리와 추리로 차근차근 풀고 싶다면", ids: ["bug-sweeper", "hallu-detective", "prompt-fortress"] },
  { lead: "자리를 잡고 계획을 세우며 키우고 싶다면", ids: ["tiny-isle", "agent-town", "rack-tycoon"] },
];
const categories = [...new Set(liveGames.map((game) => game.category))];
const pill =
  "rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-bold text-slate-700 aria-pressed:border-primary aria-pressed:bg-primary aria-pressed:text-white";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Zepio",
  url: new URL("/", Astro.site).href,
  inLanguage: "ko",
};
---

<BaseLayout
  size="home"
  title="Zepio | 무료 웹게임"
  description="회원가입 없이 브라우저에서 바로 즐기는 무료 웹게임 플랫폼 Zepio입니다."
  jsonLd={jsonLd}
>
  <section class="flex items-center gap-4 rounded-3xl bg-gradient-to-br from-primary to-violet-700 p-5 text-white sm:p-8">
    <div class="flex-1">
      <h1 class="text-3xl font-extrabold sm:text-4xl">Play Something New</h1>
      <p class="mt-2 text-indigo-100">다운로드나 회원가입 없이 브라우저에서 바로 즐기는 무료 웹게임.</p>
      <a href="#games" class="mt-4 inline-block rounded-xl bg-white px-5 py-2.5 font-bold text-primary">
        게임 둘러보기
      </a>
    </div>
    <Mascot size={96} class="size-20 shrink-0 sm:size-28" />
  </section>

  {
    dailyGame && (
      <section
        data-daily
        data-game-id={dailyGame.id}
        class="mt-8 rounded-2xl border border-primary/30 bg-indigo-50 p-4"
      >
        <h2 class="text-lg font-bold">오늘의 도전</h2>
        <p data-daily-text class="mt-1 text-sm text-slate-700">
          매일 새로 열리는 5문제. 모두 같은 문제로 도전해요.
        </p>
        <a
          href={`/games/${dailyGame.slug}`}
          class="mt-3 inline-block rounded-xl bg-primary px-5 py-2.5 font-bold text-white"
        >
          도전하러 가기
        </a>
      </section>
    )
  }

  <section data-recent hidden class="mt-8">
    <h2 class="mb-3 text-xl font-bold">이어서 하기</h2>
    <ul data-recent-list class="flex flex-wrap gap-2"></ul>
  </section>

  <h2 id="games" class="mb-3 mt-8 scroll-mt-4 text-xl font-bold">추천 게임</h2>
  <div class="mb-4 flex flex-col gap-2" data-sort-bar>
    <div class="flex flex-wrap items-center gap-1.5" role="group" aria-label="정렬">
      <span class="mr-1 text-xs font-extrabold text-slate-600">정렬</span>
      {
        SORTS.map((sort) => (
          <button type="button" data-sort={sort.id} data-needs-records={sort.needsRecords ? "" : undefined} aria-pressed={sort.id === "recommended" ? "true" : "false"} class={pill}>
            {sort.label}
          </button>
        ))
      }
    </div>
    <div class="flex flex-wrap items-center gap-1.5" role="group" aria-label="분류">
      <span class="mr-1 text-xs font-extrabold text-slate-600">분류</span>
      <button type="button" data-category-filter="all" aria-pressed="true" class={pill}>전체</button>
      {
        categories.map((category) => (
          <button type="button" data-category-filter={category} aria-pressed="false" class={pill}>
            {CATEGORY_LABELS[category] ?? category}
          </button>
        ))
      }
    </div>
  </div>
  <ul data-game-list class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      liveGames.map((game, index) => (
        <li
          data-game-card={game.id}
          data-slug={game.slug}
          data-name={game.name}
          data-order={index}
          data-category={game.category}
          data-minutes={parseInt(game.estimatedPlayTime.match(/\d+/)?.[0] ?? "0", 10)}
          class="overflow-hidden rounded-2xl bg-white shadow-sm transition hover:-translate-y-0.5 hover:shadow-md motion-reduce:transition-none motion-reduce:hover:translate-y-0"
        >
          <img
            src={game.thumbnail}
            alt=""
            width="320"
            height="180"
            loading={index >= 2 ? "lazy" : undefined}
            fetchpriority={index === 0 ? "high" : undefined}
            decoding="async"
            class="aspect-video w-full object-cover"
          />
          <div class="p-4">
            <div class="flex items-center justify-between gap-2">
              <h3 class="text-lg font-bold">{game.name}</h3>
              <span class="shrink-0 rounded-full bg-indigo-50 px-2.5 py-0.5 text-xs font-bold text-primary">
                {CATEGORY_LABELS[game.category] ?? game.category}
              </span>
            </div>
            <p class="mt-1 text-sm text-slate-600">{game.description}</p>
            <p class="mt-1 text-xs text-slate-600">{game.estimatedPlayTime}</p>
            <p data-record hidden class="mt-1 text-sm font-bold text-primary" />
            <a
              href={`/games/${game.slug}`}
              class="mt-3 inline-block rounded-xl bg-primary px-5 py-2.5 font-bold text-white"
            >
              플레이하기
            </a>
          </div>
        </li>
      ))
    }
  </ul>
  <section class="mt-12 max-w-3xl">
    <h2 class="text-xl font-bold">Zepio는 이런 곳입니다</h2>
    <p class="mt-2">
      Zepio는 다운로드나 회원가입 없이 브라우저에서 바로 즐기는 무료 웹게임 모음입니다. 규칙을 보면 바로 이해되는 짧은
      퍼즐과 아케이드부터 몇십 분 붙잡고 키우는 시뮬레이션까지, 직접 만든 게임을 하나씩 늘려 가고 있습니다. 기록은 내
      브라우저에만 저장되고, 게임마다 하는 방법과 공략 팁이 함께 있어서 처음 하는 게임도 부담이 없습니다.
    </p>

    <h3 class="mt-6 text-lg font-bold">어떤 게임부터 할까요?</h3>
    <ul class="mt-2 list-disc space-y-1.5 pl-5">
      {
        GUIDE.map(({ lead, ids }) => (
          <li>
            {lead}{" "}
            {ids.map((id, i) => {
              const game = liveGames.find((entry) => entry.id === id);
              return (
                game && (
                  <>
                    {i > 0 && ", "}
                    <a href={`/games/${game.slug}/`} class="font-semibold text-primary underline">
                      {game.name}
                    </a>
                    <span class="text-sm text-slate-600"> ({game.estimatedPlayTime})</span>
                  </>
                )
              );
            })}
          </li>
        ))
      }
    </ul>
    <p class="mt-4 text-sm text-slate-600">
      Zepio는 계속 게임을 추가하고 있습니다. 제안이나 오류는 <a href="/contact/" class="underline">문의</a> 페이지로 알려 주세요.
    </p>
  </section>
</BaseLayout>

<script>
  import "../scripts/home-records.js";
</script>