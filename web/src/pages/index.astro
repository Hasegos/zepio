---
import BaseLayout from "../layouts/BaseLayout.astro";
import { liveGames } from "../games/registry.js";
---

<BaseLayout
  title="Zepio | 무료 웹게임"
  description="회원가입 없이 브라우저에서 바로 즐기는 무료 웹게임 플랫폼 Zepio입니다."
>
  <h1 class="text-3xl font-extrabold">Play Something New</h1>
  <p class="mt-2 text-slate-600">다운로드나 회원가입 없이 브라우저에서 바로 즐기는 무료 웹게임.</p>

  <section data-recent hidden class="mt-8">
    <h2 class="mb-3 text-xl font-bold">이어서 하기</h2>
    <ul data-recent-list class="flex flex-wrap gap-2"></ul>
  </section>

  <h2 id="games" class="mb-3 mt-8 scroll-mt-4 text-xl font-bold">추천 게임</h2>
  <ul class="grid gap-4 sm:grid-cols-2">
    {
      liveGames.map((game) => (
        <li
          data-game-card={game.id}
          data-slug={game.slug}
          data-name={game.name}
          class="overflow-hidden rounded-2xl bg-white shadow-sm"
        >
          <img src={game.thumbnail} alt="" width="320" height="180" class="aspect-video w-full object-cover" />
          <div class="p-4">
            <h3 class="text-lg font-bold">{game.name}</h3>
            <p class="mt-1 text-sm text-slate-600">{game.description}</p>
            <p class="mt-1 text-xs text-slate-600">{game.estimatedPlayTime}</p>
            <p data-record hidden class="mt-1 text-sm font-bold text-primary" />
            <a
              href={`/games/${game.slug}`}
              class="mt-3 inline-block rounded-xl bg-primary px-5 py-2.5 font-bold text-white"
            >
              플레이하기
            </a>
          </div>
        </li>
      ))
    }
  </ul>
</BaseLayout>

<script>
  import { summarizers } from "../games/records.js";
  import { loadRecords } from "../lib/storage.js";

  const { games, recent } = loadRecords();
  const cards = new Map(
    [...document.querySelectorAll("[data-game-card]")].map((card) => [card.dataset.gameCard, card]),
  );

  for (const [id, card] of cards) {
    const entry = games[id];
    const plays = Number.isInteger(entry?.plays) ? entry.plays : 0;
    const text = entry ? summarizers[id]?.(entry.data, plays) : "";
    const line = card.querySelector("[data-record]");
    if (text && line) {
      line.textContent = text;
      line.hidden = false;
    }
  }

  const list = document.querySelector("[data-recent-list]");
  const section = document.querySelector("[data-recent]");
  const ids = recent.filter((id) => cards.has(id));
  if (list && section && ids.length) {
    for (const id of ids) {
      const card = cards.get(id);
      const link = document.createElement("a");
      link.href = `/games/${card.dataset.slug}`;
      link.textContent = card.dataset.name;
      link.className = "rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-bold text-primary";
      const item = document.createElement("li");
      item.append(link);
      list.append(item);
    }
    section.hidden = false;
  }
</script>