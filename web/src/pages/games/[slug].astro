---
import BaseLayout from "../../layouts/BaseLayout.astro";
import GameStage from "../../components/GameStage.astro";
import { liveGames } from "../../games/registry.js";
import { canonicalUrl } from "../../lib/site.js";

/**
 * live 게임마다 정적 페이지 경로를 만든다.
 *
 * @returns 슬러그와 게임 항목 목록
 */
export function getStaticPaths() {
  return liveGames.map((game) => ({ params: { slug: game.slug }, props: { game } }));
}

const { game } = Astro.props;
const contents = import.meta.glob("../../games/*/content.js", { eager: true });
const content = contents[`../../games/${game.slug}/content.js`]?.default;
if (!content?.intro?.length || !content?.howToPlay?.length || !content.tips?.length || !content.audience || !content.faq?.length) {
  throw new Error(`${game.slug}: content.js에 intro, howToPlay, tips, audience, faq가 필요합니다.`);
}

const image = `/games/${game.slug}/og.png`;
const pageUrl = canonicalUrl(Astro.site, Astro.url.pathname);
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "VideoGame",
    name: game.name,
    description: game.description,
    url: pageUrl,
    image: new URL(image, Astro.site).href,
    inLanguage: "ko",
    applicationCategory: "Game",
    gamePlatform: "Web browser",
    operatingSystem: "Any",
    isAccessibleForFree: true,
    offers: { "@type": "Offer", price: 0, priceCurrency: "KRW" },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "홈", item: new URL("/", Astro.site).href },
      { "@type": "ListItem", position: 2, name: game.name, item: pageUrl },
    ],
  },
];
---

<BaseLayout
  title={game.seoTitle ?? `${game.name} | Zepio`}
  description={game.description}
  image={image}
  imageAlt={`${game.name} 게임 화면`}
  jsonLd={jsonLd}
  size={game.wide ? "wide" : "text"}
>
  <nav class="mb-3 text-sm text-slate-600" aria-label="경로">
    <a href="/" class="underline">홈</a> / {game.name}
  </nav>
  <h1 class="mb-4 text-3xl font-extrabold">{game.name}</h1>

  <GameStage slug={game.slug} />

  <div class:list={[game.wide && "max-w-3xl"]}>
  <section class="mt-8">
    <h2 class="mb-2 text-xl font-bold">게임 소개</h2>
    {content.intro.map((paragraph) => <p class="mb-2">{paragraph}</p>)}
    <p class="mt-2 text-sm text-slate-600">
      플레이 시간 {game.estimatedPlayTime} · {game.supportedDevices.includes("mobile") ? "모바일" : ""}{game.supportedDevices.length > 1 ? " · " : ""}{game.supportedDevices.includes("desktop") ? "PC" : ""}
    </p>
  </section>

  <section class="mt-6">
    <h2 class="mb-2 text-xl font-bold">하는 방법</h2>
    <ol class="list-decimal space-y-1 pl-5">
      {content.howToPlay.map((step) => <li>{step}</li>)}
    </ol>
  </section>

  <section class="mt-6">
    <h2 class="mb-2 text-xl font-bold">공략 팁</h2>
    <ul class="list-disc space-y-1 pl-5">
      {content.tips.map((tip) => <li>{tip}</li>)}
    </ul>
  </section>

  <section class="mt-6">
    <h2 class="mb-2 text-xl font-bold">이런 분께 추천해요</h2>
    <p>{content.audience}</p>
  </section>

  <section class="mt-6">
    <h2 class="mb-2 text-xl font-bold">자주 묻는 질문</h2>
    <dl class="space-y-3">
      {content.faq.map((item) => (
        <div>
          <dt class="font-bold">{item.q}</dt>
          <dd class="mt-1">{item.a}</dd>
        </div>
      ))}
    </dl>
  </section>
  </div>
</BaseLayout>