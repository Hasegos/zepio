---
import BaseLayout from "../../layouts/BaseLayout.astro";
import GameStage from "../../components/GameStage.astro";
import { liveGames } from "../../games/registry.js";

/**
 * live 게임마다 정적 페이지 경로를 만든다.
 *
 * @returns 슬러그와 게임 항목 목록
 */
export function getStaticPaths() {
  return liveGames.map((game) => ({ params: { slug: game.slug }, props: { game } }));
}

const { game } = Astro.props;
const contents = import.meta.glob("../../games/*/content.js", { eager: true });
const content = contents[`../../games/${game.slug}/content.js`]?.default;
if (!content?.intro?.length || !content?.howToPlay?.length) {
  throw new Error(`${game.slug}: content.js에 intro와 howToPlay가 필요합니다.`);
}
---

<BaseLayout title={game.seoTitle ?? `${game.name} | Zepio`} description={game.description}>
  <nav class="mb-3 text-sm text-slate-600" aria-label="경로">
    <a href="/" class="underline">홈</a> / {game.name}
  </nav>
  <h1 class="mb-4 text-3xl font-extrabold">{game.name}</h1>

  <GameStage slug={game.slug} />

  <section class="mt-8">
    <h2 class="mb-2 text-xl font-bold">게임 소개</h2>
    {content.intro.map((paragraph) => <p class="mb-2">{paragraph}</p>)}
    <p class="mt-2 text-sm text-slate-600">
      플레이 시간 {game.estimatedPlayTime} · {game.supportedDevices.includes("mobile") ? "모바일" : ""}{game.supportedDevices.length > 1 ? " · " : ""}{game.supportedDevices.includes("desktop") ? "PC" : ""}
    </p>
  </section>

  <section class="mt-6">
    <h2 class="mb-2 text-xl font-bold">하는 방법</h2>
    <ol class="list-decimal space-y-1 pl-5">
      {content.howToPlay.map((step) => <li>{step}</li>)}
    </ol>
  </section>
</BaseLayout>