---
const { slug, mode = "normal" } = Astro.props;
---

<div
  data-game-stage
  data-slug={slug}
  data-mode={mode}
  class="min-h-[28rem] w-full"
>
  <p data-skeleton class="rounded-2xl bg-white p-8 text-center text-slate-600 shadow-sm">
    게임을 불러오는 중…
  </p>
</div>
<noscript>
  <p class="mt-3 rounded-xl bg-amber-50 p-4 text-sm">이 게임은 JavaScript가 필요합니다.</p>
</noscript>

<script>
  import { createGameHost } from "../lib/game-host.js";
  import { getGame } from "../games/registry.js";

  document.querySelectorAll("[data-game-stage]").forEach((root) => {
    const game = getGame(root.dataset.slug);
    if (!game) return;
    const skeleton = root.querySelector("[data-skeleton]");
    const host = createGameHost({ root, load: game.load, ctx: { mode: root.dataset.mode } });
    host.start().then(() => skeleton?.remove());
  });
</script>