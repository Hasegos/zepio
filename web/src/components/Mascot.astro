---
/**
 * 마스코트 "제피"를 그린다. 장식이라 화면 낭독기에는 숨긴다.
 * 같은 쪽에 여러 번 놓여도 id 충돌이 없게 그라디언트를 쓰지 않는다.
 * motion이 full이면 떠오르고 깜빡이고 둘러보며, calm이면 깜빡이고 안테나만 흔들리고, none이면 멈춰 있다.
 */
interface Props {
  expression?: "happy" | "think";
  size?: number;
  class?: string;
  motion?: "full" | "calm" | "none";
}

const { expression = "happy", size = 64, class: className, motion = "full" } = Astro.props;
const think = expression === "think";
const classes = [className, motion === "none" ? "" : `mascot-${motion}`].filter(Boolean).join(" ");
---

<svg
  viewBox="0 0 100 100"
  width={size}
  height={size}
  class={classes || undefined}
  aria-hidden="true"
  focusable="false"
>
  <g class="mascot-bob">
    <g class="mascot-antenna">
      <line x1="50" y1="16" x2="50" y2="7" stroke="#fff" stroke-width="3" stroke-linecap="round"></line>
      <circle cx="50" cy="7" r="5" fill="#f59e0b" stroke="#fff" stroke-width="2"></circle>
    </g>
    <rect x="8" y="16" width="84" height="76" rx="26" fill="#5b5fc7" stroke="#fff" stroke-width="3"></rect>
    <g class="mascot-eyes">
      <circle cx="34" cy="50" r="10" fill="#fff"></circle>
      <circle cx="66" cy="50" r="10" fill="#fff"></circle>
      <g class="mascot-pupils">
        <circle cx={think ? 37 : 35} cy={think ? 46 : 51} r="5" fill="#0f172a"></circle>
        <circle cx={think ? 69 : 67} cy={think ? 46 : 51} r="5" fill="#0f172a"></circle>
      </g>
    </g>
    <rect x="17" y="64" width="9" height="9" rx="3" fill="#fbbf24"></rect>
    <rect x="74" y="64" width="9" height="9" rx="3" fill="#fbbf24"></rect>
    {
      think ? (
        <path d="M40 74 H58" stroke="#fff" stroke-width="4" stroke-linecap="round" fill="none"></path>
      ) : (
        <path d="M38 69 Q50 82 62 69" stroke="#fff" stroke-width="4" stroke-linecap="round" fill="none"></path>
      )
    }
  </g>
</svg>